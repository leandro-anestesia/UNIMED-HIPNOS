# Chave da API da Anthropic (console.anthropic.com) — a mesma do app da outra equipe.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Conta de serviço do Google, o JSON inteiro numa linha só — a mesma do app da
# outra equipe. É ela que precisa estar como Editor da pasta do Drive.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

# ID da pasta do Drive DESTA equipe (o trecho depois de /folders/ na URL).
# É outra pasta, de outro dono — não repita a do app da outra equipe.
GOOGLE_DRIVE_FOLDER_ID=

# Preenchidas automaticamente pela Vercel quando o banco KV (Upstash) é
# conectado ao projeto. Não preencha à mão.
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Acesso ao app. AS DUAS SÃO OPCIONAIS: sem nenhuma delas a tranca funciona.
# ─────────────────────────────────────────────────────────────────────────────

# Assina os cookies de acesso. Se não existir, a chave é derivada do
# KV_REST_API_TOKEN acima, que a Vercel já preenche — é o que faz a tranca valer
# desde o primeiro deploy, sem ninguém precisar lembrar de criar variável.
# Criar ou trocar esta aqui derruba todos os aparelhos de uma vez (é só digitar
# o PIN de novo).
ACESSO_SEGREDO=

# PIN de emergência, 6 dígitos. Entra como mestre em quem JÁ É mestre — é o
# conserto para o caso de o mestre esquecer o próprio PIN e não haver um segundo
# mestre para zerá-lo. Sem ela, o resgate é o segundo mestre.
ACESSO_PIN_MESTRE=
